# Copiar como .env y completar con los valores del entorno local
PORT=3002
API_PREFIX=api/v1
CORS_ORIGINS=*

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=candyland
DB_MIGRATIONS_RUN=true

# Autenticación (obligatorio): clave larga y aleatoria para firmar los tokens JWT
JWT_SECRET=
# Duración de la sesión (una jornada de atención)
JWT_EXPIRES_IN=10h

# Administrador inicial: solo se usa si la base de datos no tiene usuarios
ADMIN_USERNAME=
ADMIN_PASSWORD=
